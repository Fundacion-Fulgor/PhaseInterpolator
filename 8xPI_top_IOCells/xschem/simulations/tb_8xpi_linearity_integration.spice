* Circuit Parameters
.param vdd = 1.2
.param vss = 0.0
.param SR_control=110p
.options TEMP = 27.0
.OPTION RSHUNT=1e10
.OPTION CSHUNT=1e-15
.option rseries = 1e-4
.option ITL1 = 500
.option ITL2 = 300
.option ITL4 = 150
.option maxord=2
.options method=gear reltol=5e-3 abstol=1e-8 vntol=1e-4
.options gmin=1e-9
.options pivtol=1e-10
.options chgtol=1e-12

