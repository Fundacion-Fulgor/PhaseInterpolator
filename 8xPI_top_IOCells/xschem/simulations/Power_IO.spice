** sch_path: /foss/designs/IHP-Open-PDK/ihp-sg13g2/libs.tech/xschem/sg13g2_io_tests/Power_IO.sch
**.subckt Power_IO
V1 IO_vdd GND 1.2
V2 IO_iovdd GND 3.3
V3 IO_vss GND 0
V4 IO_iovss GND 0
Vc2p inp GND dc 0 ac 1 pulse(0, 1.2, 1n, 1n, 1n, 50n, 100n )
x1 IO_iovdd IO_iovss IO_vss IO_vdd sg13g2_IOPadIOVdd
x3 IO_iovdd IO_iovss IO_vss IO_vdd sg13g2_IOPadIOVss
x2 IO_iovdd IO_iovss IO_vss IO_vdd sg13g2_IOPadVSS
x4 IO_iovdd IO_iovss IO_vss IO_vdd sg13g2_IOPadVdd
x5 IO_iovdd IO_iovss out IO_vss IO_vdd inp sg13g2_IOPadIn
C1 out IO_vss 100f m=1
XX6 IO_iovss bondpad size=80u shape=0 padtype=0
XX7 IO_iovdd bondpad size=80u shape=0 padtype=0
XX8 IO_vdd bondpad size=80u shape=0 padtype=0
XX9 IO_vss bondpad size=80u shape=0 padtype=0
XX10 inp bondpad size=80u shape=0 padtype=0
XX12 Padout bondpad size=80u shape=0 padtype=0
x13 IO_iovdd IO_iovss out_a IO_vss IO_vdd in_a sg13g2_IOPadAnalog
C2 out_a IO_vss 200f m=1
XX14 in_a bondpad size=80u shape=0 padtype=0
Vc1 in_a GND dc 0 ac 0 sin(0.6, 0.5, 100meg, 1n)
V5 GND sub! 0
C3 inp IO_vss 100f m=1
V6 out_en GND 1.2
x11 IO_iovdd IO_iovss inp IO_vss IO_vdd Padout sg13g2_IOPadOut4mA
x15 IO_iovdd IO_iovss inp out_en IO_vss IO_vdd Tri_out sg13g2_IOPadTriOut16mA
XX16 Tri_out bondpad size=80u shape=0 padtype=0
C5 GND Tri_out 200f m=1
R2 Tri_out GND 50k m=1
C4 GND Padout 200f m=1
R1 Padout GND 50k m=1
**** begin user architecture code

.lib cornerMOSlv.lib mos_tt
.lib cornerMOShv.lib mos_tt
.lib cornerRES.lib res_typ
.include diodes.lib
.include sg13g2_bondpad.lib



.param temp=27
*.OPTION RSHUNT=1e6
.OPTION CSHUNT=1e-13
.option rseries = 10.0e-0
.options method=gear reltol=1e-3 abstol=1e-6
*.options gmin=1e-10
*.ic V(out)=0

.control
save all
tran  601p 180n
meas tran tdelayf TRIG v(inp) VAl=0.6 FALl=1 TARG v(out) VAl=0.6 FALL=1
meas tran tdelayr TRIG v(inp) VAl=0.6 RISE=2 TARG v(out) VAl=0.6 RISE=2
write power_io.raw


.endc


**** end user architecture code
**.ends

