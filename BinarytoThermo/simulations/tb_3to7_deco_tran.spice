** sch_path: /foss/designs/PhaseInterpolator/BinarytoThermo/tb_3to7_deco_tran.sch
**.subckt tb_3to7_deco_tran
V7 VS[0] VSS PULSE({a*1.2} {d*1.2} 250PS 2PS 2PS 500PS)
V1 VS[1] VSS PULSE({b*1.2} {d*1.2} 250PS 2PS 2PS 500PS)
V2 VS[2] VSS PULSE({c*1.2} {d*1.2} 250PS 2PS 2PS 500PS)
V3 VSS GND DC{VSS}
V4 VDD VSS DC{VDD}
x1 vo_st7 vo_st6 vo_st5 vo_st4 vo_st3 vo_st2 vo_st1 VS[2] VS[1] VS[0] VDD VSS 3to7_deco
x4[6] VDD net1_6 vo_st7 VSS inv
x4[5] VDD net1_5 vo_st6 VSS inv
x4[4] VDD net1_4 vo_st5 VSS inv
x4[3] VDD net1_3 vo_st4 VSS inv
x4[2] VDD net1_2 vo_st3 VSS inv
x4[1] VDD net1_1 vo_st2 VSS inv
x4[0] VDD net1_0 vo_st1 VSS inv
C3[6] net1_6 VSS 1p m=1
C3[5] net1_5 VSS 1p m=1
C3[4] net1_4 VSS 1p m=1
C3[3] net1_3 VSS 1p m=1
C3[2] net1_2 VSS 1p m=1
C3[1] net1_1 VSS 1p m=1
C3[0] net1_0 VSS 1p m=1
